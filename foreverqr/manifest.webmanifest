{
  "name": "ForeverQR: QR codes that never expire",
  "short_name": "ForeverQR",
  "description": "Free static QR code generator and ad-free scanner. No signup, no watermark, codes never expire.",
  "id": "/foreverqr/",
  "start_url": "/foreverqr/?source=pwa",
  "scope": "/foreverqr/",
  "display": "standalone",
  "background_color": "#f4efe6",
  "theme_color": "#1f6b4f",
  "lang": "en",
  "categories": ["utilities", "productivity", "business"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Wi-Fi QR code", "short_name": "Wi-Fi", "url": "/foreverqr/?type=wifi&label=Scan%20for%20Wi-Fi", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan a QR code", "short_name": "Scan", "url": "/foreverqr/#scan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
